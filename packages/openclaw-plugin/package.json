{
  "name": "openclaw-quota-pilot",
  "version": "0.3.14",
  "description": "Zero-LLM OpenAI quota monitoring and OAuth profile routing for OpenClaw",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "files": [
    "dist/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "vitest run",
    "validate": "npm run build && node ../../scripts/validate-plugin.mjs"
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-2"
  },
  "devDependencies": {
    "openclaw": "2026.7.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.7.1-2",
      "minGatewayVersion": "2026.7.1-2"
    },
    "build": {
      "openclawVersion": "2026.7.1-2",
      "pluginSdkVersion": "2026.7.1-2"
    }
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
